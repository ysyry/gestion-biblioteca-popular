# ── Conexión a Koha (DigiBePé) ─────────────────────────────────────────────
# URL base de la INTRANET (staff), sin barra final.
KOHA_BASE_URL=http://3169.bepe.ar:8080
# Credenciales SOLO para scripts/probe_koha.py (la app usa las de cada bibliotecaria).
KOHA_USER=
KOHA_PASSWORD=

# ── IDs de los reportes SQL guardados en la intranet ───────────────────────
# Completar después de crear cada reporte (ver backend/sql/). Dejar vacío si aún no existe.
REPORT_MEMBER_SEARCH_ID=
REPORT_MEMBER_LOANS_ID=
REPORT_LOANS_ACTIVE_ID=
REPORT_LOANS_OVERDUE_ID=
REPORT_MEMBER_PROFILE_ID=
REPORT_MEMBER_ACCOUNT_ID=
REPORT_MEMBER_HISTORY_ID=

# ── Auth de la app ─────────────────────────────────────────────────────────
# Las bibliotecarias entran con su usuario/contraseña de Koha. Esta clave solo
# firma el token de sesión que emite la app. Cambiala por algo aleatorio largo.
APP_SECRET_KEY=cambiar-esto-por-un-secreto-largo-y-aleatorio
APP_TOKEN_EXPIRE_MINUTES=480

# ── CORS (orígenes del frontend permitidos, separados por coma) ────────────
CORS_ORIGINS=http://localhost:5173

# ── Usuarios propios de la app (comisión directiva y subcomisiones) ────────
# Las bibliotecarias entran con Koha y no hace falta darlas de alta. La comisión
# y las subcomisiones sí: se crean desde la app, en la sección "Usuarios".
# Lista de subcomisiones que se ofrecen al dar de alta (separadas por coma).
SUBCOMISIONES=Cultura,Prensa,Infantil,Huerta
# Espacios que se pueden reservar. Solo se usan para SEMBRAR la lista la primera vez;
# después se editan desde la app (Solicitudes → Espacios). Si se deja vacío, la app
# siembra unos nombres de ejemplo y los marca como tales hasta que se corrijan.
ESPACIOS=Sala principal,Sala infantil,Patio,Salón de talleres
# La comisión directiva ve los mismos datos que las bibliotecarias, pero no tiene
# usuario de Koha: sus consultas salen por KOHA_USER / KOHA_PASSWORD (arriba).
# Sin esas credenciales, la comisión entra igual pero no ve nada de Koha.

# ── Reservas aprobadas → Google Calendar ───────────────────────────────────
# A qué calendario se publican las reservas de espacio aprobadas: el nombre de uno
# de los CALENDAR_<n>_NAME de la agenda (el id sale de su dirección iCal) o
# directamente el id del calendario (algo@gmail.com).
# Usa la misma cuenta de servicio de Google que las cuotas (GOOGLE_SERVICE_ACCOUNT_JSON).
# En Google hace falta: (1) habilitar la "Google Calendar API" en el proyecto de esa
# cuenta, y (2) compartir el calendario con la cuenta de servicio con el permiso
# "Hacer cambios en los eventos". Mientras tanto, lo aprobado se ve en la app y queda
# "pendiente de publicar"; se reintenta solo cada 15 minutos.
RESERVAS_CALENDARIO=Bayer Band

# ── URL pública de la app ──────────────────────────────────────────────────
# Se usa para el logo de los mails, para el píxel que registra si los abrieron y
# para armar los links del registro de actividades (los que se comparten por
# WhatsApp o en un cartel con QR).
# SIN esta variable el historial se guarda igual, pero no hay dato de "abrió", y
# los links del registro salen sin dirección, así que no se pueden compartir.
# En Railway: https://<tu-dominio>.up.railway.app · En local: http://localhost:8000
APP_PUBLIC_URL=

# ── Envío de mails: proveedor ──────────────────────────────────────────────
# "smtp" (Gmail, local) o "resend" (API HTTPS; Railway bloquea SMTP saliente).
MAIL_PROVIDER=smtp
RESEND_API_KEY=
MAIL_FROM=

# ── Envío de mails (SMTP) ──────────────────────────────────────────────────
# Ejemplo Gmail: host=smtp.gmail.com puerto=587, user=cuenta@gmail.com,
# password = "contraseña de aplicación" (no la normal), from=cuenta@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Biblioteca Popular Osvaldo Bayer
SMTP_USE_TLS=true
# SEGURIDAD: en true NO envía de verdad (simula) — vale para Mails, para las pruebas
# de Automáticos y para el programador. Poné false recién cuando quieras enviar.
MAIL_DRY_RUN=true

# ── ARCA (ex-AFIP) · Factura Electrónica ───────────────────────────────────
# EN CONSTRUCCIÓN: el módulo existe pero todavía no se usa desde la app.
# Dejalo en ARCA_ENABLED=false hasta que esté probado en homologación.
# Emisión de Factura C (asociación exenta) vía WSFEv1.
# El certificado y la clave NO van acá: se dejan en backend/credentials/
# (arca_homo.crt / arca_homo.key en homologación; arca_prod.* en producción).
ARCA_ENABLED=false
# false = homologación (pruebas, CAE de mentira) · true = producción (real)
ARCA_PROD=false
ARCA_CUIT=30675834306
ARCA_PTO_VTA=2
# Opcional: rutas explícitas al cert/clave. Vacío = credentials/arca_{homo|prod}.{crt,key}
ARCA_CERT_PATH=
ARCA_KEY_PATH=
